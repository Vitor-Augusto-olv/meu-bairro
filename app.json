{
  "expo": {
    "name": "Meu Bairro",
    "slug": "meu-bairro",
    "version": "1.0.0",
    "scheme": "meubairro",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "br.com.fiap.meubairro",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolher a foto do problema do bairro.",
          "cameraPermission": "Fotografar o problema do bairro."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Registrar onde o problema está."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7559398c-1232-4140-96d8-01819ad0d233"
      }
    }
  }
}
